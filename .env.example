# DLNA Gateway — environment configuration template.
#
# Copy this file to `.env` and fill in your values. `.env` is gitignored,
# so your real secrets stay local. Loaded automatically at startup by
# dlna_config.py (via python-dotenv if installed). Any variable already
# set in the process environment (launchd plist, systemd
# EnvironmentFile, shell export, …) wins over `.env`.

# ── Subsonic API ───────────────────────────────────────────────
# Authentication for the /rest/* API (CarPlay via Amperfy etc.).
# Leave SUBSONIC_PASSWORD empty to refuse all Subsonic calls
# (the API then returns 503 — safe default if you don't use it).
SUBSONIC_USER=user
SUBSONIC_PASSWORD=

# ── External-service contact email ─────────────────────────────
# Sent in the User-Agent of outbound HTTP calls to MusicBrainz,
# coverartarchive.org, and radio-browser.info. These services REQUIRE
# an identifying contact in the UA per their ToS — anonymous calls
# get rate-limited or 403-blocked. Use a real email you don't mind
# those three services seeing.
GATEWAY_CONTACT_EMAIL=you@example.com

# ── Tailscale cert renewal (optional, macOS only) ──────────────
# Only needed if you use renew-cert.sh / the cert-renew LaunchAgent.
# Set to the tailnet hostname Tailscale issued the cert for, e.g.
#   TAILSCALE_CERT_HOST=mymachine.tailXXXXX.ts.net
TAILSCALE_CERT_HOST=
