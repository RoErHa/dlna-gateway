# DLNA Gateway — environment configuration template.
#
# .env is THE configuration file — every gateway setting lives here, in
# one place (the LaunchAgent plist carries only PATH + the launch
# command). Copy this file to `.env` and fill in your values; `.env` is
# gitignored, so your real paths and secrets stay local.
#
# Loaded at startup by dlna_config.py — via python-dotenv when
# installed, else a built-in parser, so the file ALWAYS loads. A
# variable already set in the process environment (shell export,
# `launchctl setenv`, systemd EnvironmentFile) wins over `.env` for
# ad-hoc overrides.

# ── Gateway identity ───────────────────────────────────────────
# UPnP renderers/TVs know the gateway by this UDN + name — changing
# them makes clients see a brand-new server (lost presets etc.).
# Pick once, keep forever. APP_VERSION is the release-line marker
# shown at /api/version and in the PWA header.
GW_UDN=uuid:dlna-gateway-CHANGE-ME
GW_NAME=DLNA Gateway
APP_VERSION=2.0.0

# ── Music library (LocalFs backend) ────────────────────────────
# Root folder of your music. The in-process file server serves the
# original bytes from LOCALFS_PORT (bit-perfect; renderers fetch
# directly). NOTE: stream URLs embed this port — changing it later
# orphans play_counts/lyrics/overrides rows keyed on the old URLs.
LOCALFS_MUSIC_ROOT=/path/to/Music
LOCALFS_PORT=8200
# Optional override when LAN-IP autodetection picks the wrong
# interface, e.g. http://192.168.1.5:8200
#LOCALFS_BASE_URL=

# ── Video library (optional) ───────────────────────────────────
# Home-video folder: enables the 5-min GWMovies scan + the 📹 Videos
# tree (LG TV / PWA), served from the same file server. Unset = off.
#LOCALFS_VIDEO_ROOT=/path/to/GWMovies

# ── Audiobooks library (optional) ──────────────────────────────
# Audiobook folder: a second LocalFs source with its own UDN so books
# never mix into music browse / radio / search. A book = a folder;
# resume positions + OpenLibrary series metadata key on it. Unset = off.
#AUDIOBOOKS_ROOT=/path/to/Audiobooks

# ── Subsonic API ───────────────────────────────────────────────
# Authentication for the /rest/* API (CarPlay via Amperfy etc.).
# Leave SUBSONIC_PASSWORD empty to refuse all Subsonic calls
# (the API then returns 503 — safe default if you don't use it).
SUBSONIC_USER=user
SUBSONIC_PASSWORD=

# ── External-service contact email ─────────────────────────────
# Sent in the User-Agent of outbound HTTP calls to MusicBrainz,
# coverartarchive.org, radio-browser.info, and openlibrary.org. These
# services REQUIRE an identifying contact in the UA per their ToS —
# anonymous calls get rate-limited or 403-blocked. Use a real email
# you don't mind those services seeing.
GATEWAY_CONTACT_EMAIL=you@example.com

# ── Tailscale cert renewal (optional, macOS only) ──────────────
# Only needed if you use renew-cert.sh / the cert-renew LaunchAgent.
# Set to the tailnet hostname Tailscale issued the cert for, e.g.
#   TAILSCALE_CERT_HOST=mymachine.tailXXXXX.ts.net
TAILSCALE_CERT_HOST=

# ── Immich people sync (optional) ──────────────────────────────
# Only needed for tools/immich_people_sync.py (person tags on videos).
#IMMICH_URL=http://localhost:2283
#IMMICH_API_KEY=

# ── Rarely needed ──────────────────────────────────────────────
# Plain-HTTP port the UPnP /gw/* surface answers on (must match the
# hypercorn --insecure-bind port in the LaunchAgent). Default 8765.
#GATEWAY_PLAIN_PORT=8765
# Video rescan cadence in seconds (default 300).
#VIDEO_SCAN_INTERVAL_SEC=300
