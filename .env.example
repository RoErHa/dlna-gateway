# DLNA Gateway — environment configuration template.
#
# .env is THE configuration file — every gateway setting lives here, in
# one place (the LaunchAgent plist carries only PATH + the launch
# command). Copy this file to `.env` and fill in your values; `.env` is
# gitignored, so your real paths and secrets stay local.
#
# Loaded at startup by dlna_config.py — via python-dotenv when
# installed, else a built-in parser, so the file ALWAYS loads. A
# variable already set in the process environment (shell export,
# `launchctl setenv`, systemd EnvironmentFile) wins over `.env` for
# ad-hoc overrides.

# ── Gateway identity ───────────────────────────────────────────
# UPnP renderers/TVs know the gateway by this UDN + name — changing
# them makes clients see a brand-new server (lost presets etc.).
# Pick once, keep forever. APP_VERSION is the release-line marker
# shown at /api/version and in the PWA header.
GW_UDN=uuid:dlna-gateway-CHANGE-ME
GW_NAME=DLNA Gateway
APP_VERSION=2.2.0

# ── Music library (LocalFs backend) ────────────────────────────
# Root folder of your music. The in-process file server serves the
# original bytes from LOCALFS_PORT (bit-perfect; renderers fetch
# directly). NOTE: stream URLs embed this port — changing it later
# orphans play_counts/lyrics/overrides rows keyed on the old URLs.
LOCALFS_MUSIC_ROOT=/path/to/Music
LOCALFS_PORT=8200
# Optional override when LAN-IP autodetection picks the wrong
# interface, e.g. http://192.168.1.5:8200
#LOCALFS_BASE_URL=

# ── Video library (optional) ───────────────────────────────────
# Home-video folder: enables the 5-min GWMovies scan + the 📹 Videos
# tree (LG TV / PWA), served from the same file server. Titles come
# from metadata (GPS reverse-geocode + timestamp), never from filenames.
# See docs/VIDEO_SUPPORT.md. Unset = off.
#LOCALFS_VIDEO_ROOT=/path/to/GWMovies
# Files in the video root may be symlinks to originals in these folders
# (colon-separated), instead of copies. Video route only, symlinks only,
# video extensions only: see resolve_video_link. Unset = no exception.
# tools/immich_import.py refuses to link into a folder not listed here.
#LOCALFS_VIDEO_LINK_ROOTS=/path/to/Immich-library-1:/path/to/Immich/library:/path/to/Immich/upload

# ── Audiobooks library (optional) ──────────────────────────────
# Audiobook folder: a second LocalFs source with its own UDN so books
# never mix into music browse / radio / search. A book = a folder;
# resume positions + OpenLibrary series metadata key on it. Unset = off.
#AUDIOBOOKS_ROOT=/path/to/Audiobooks

# ── External UPnP MediaServers (optional) ──────────────────────
# Comma-separated friendly-name PREFIXES (case-insensitive) of LAN
# MediaServers to index alongside LocalFs, e.g. MinimServer. Unset =
# none: every other MediaServer on the LAN (TV media shares, Plex
# DLNA, …) is ignored so it never appears in the source picker.
#UPNP_SERVER_ALLOW=MinimServer

# ── Subsonic API ───────────────────────────────────────────────
# Authentication for the /rest/* API (CarPlay via Amperfy etc.).
# Leave SUBSONIC_PASSWORD empty to refuse all Subsonic calls
# (the API then returns 503 — safe default if you don't use it).
SUBSONIC_USER=user
SUBSONIC_PASSWORD=

# ── External-service contact email ─────────────────────────────
# Sent in the User-Agent of outbound HTTP calls to MusicBrainz,
# coverartarchive.org, radio-browser.info, and openlibrary.org. These
# services REQUIRE an identifying contact in the UA per their ToS —
# anonymous calls get rate-limited or 403-blocked. Use a real email
# you don't mind those services seeing.
GATEWAY_CONTACT_EMAIL=you@example.com

# ── Tailscale cert renewal (optional, macOS only) ──────────────
# Only needed if you use renew-cert.sh / the cert-renew LaunchAgent.
# Set to the tailnet hostname Tailscale issued the cert for, e.g.
#   TAILSCALE_CERT_HOST=mymachine.tailXXXXX.ts.net
TAILSCALE_CERT_HOST=

# Every LaunchAgent that LOADS this certificate, comma-separated: after a
# real renewal renew-cert.sh restarts each, so none keeps serving the old one
# until it expires. List anything else pointed at these .crt/.key files (a
# sibling app such as epub-reader). Unset → the gateway alone.
#   CERT_RELOAD_LABELS=com.example.dlna-gateway,com.example.epub-reader
CERT_RELOAD_LABELS=
# Rarely needed by renew-cert.sh: renew when fewer than this many days are
# left (default 30); the binaries, when not on launchd's PATH; and the
# gateway's LaunchAgent label, restarted when CERT_RELOAD_LABELS is unset.
#RENEW_DAYS=30
#TAILSCALE_BIN=/usr/local/bin/tailscale
#OPENSSL_BIN=/usr/bin/openssl
#GATEWAY_LAUNCHD_LABEL=com.example.dlna-gateway

# ── Weekly library backup (optional, macOS only) ───────────────
# backup-library.sh checks, after its own snapshot, that Time Machine's
# newest backup is at most this many days old, and fails (→ a backup_failed
# alert) when it is older or Time Machine reports none: an unplugged disk
# otherwise goes unnoticed. Default 3; 0 turns the check off. Skipped
# without a Time Machine destination. Read by the script, never sourced.
#BACKUP_TM_MAX_AGE_DAYS=3

# ── Immich (optional — video person tags / importer) ───────────
# Used ONLY by tools/immich_people_sync.py and tools/immich_import.py,
# never by the running gateway.
#IMMICH_URL=http://localhost:2283
#IMMICH_API_KEY=

# ── Last.fm (optional — "best known for" on the artist panel) ──
# An APPLICATION key, NOT your account password: read methods like
# artist.getTopTracks authenticate with a registered app key, and the
# password is only for write methods (scrobbling). Get one instantly at
# https://www.last.fm/api/account/create — the homepage field it asks
# for can be http://localhost:8765 for a personal self-hosted app.
# Absent -> the "Best known for" block is omitted; nothing else changes.
LASTFM_API_KEY=

# ── Cover-art disk cache (optional tuning; defaults are sane) ──
# Where the cache lives (default: <repo>/art_cache, gitignored).
#ART_CACHE_DIR=
# How long a cached cover is kept (default 14 days).
#ART_CACHE_TTL_SEC=1209600
# Size cap (default 1 GiB).
#ART_CACHE_MAX_BYTES=1073741824
# How long a deterministic fetch FAILURE is remembered (default 1 h).
# Transient failures (upstream unreachable, 503) are never negative-cached.
#ART_CACHE_NEG_TTL_SEC=3600

# ── Rarely needed ──────────────────────────────────────────────
# Plain-HTTP port the UPnP /gw/* surface answers on and SSDP advertises
# (must match the port in GATEWAY_BIND_PLAIN). Default 8765.
#GATEWAY_PLAIN_PORT=8765
# Video rescan cadence in seconds (default 300).
#VIDEO_SCAN_INTERVAL_SEC=300
# Where generated video poster frames are cached (default: <repo>/video_posters).
#VIDEO_POSTER_DIR=
# Most bytes one ranged /stream request may deliver (default 8388608 = 8 MB,
# roughly 70s of 16/44 FLAC). Hypercorn's HTTP/2 path does not backpressure a
# slow reader, so without a cap the whole remainder of a file is buffered in
# the worker — the PWA is on h2, so the PWA is the case that breaks. Players
# just ask for the next slice. 0 disables the cap (the old behaviour).
#STREAM_SLICE_BYTES=8388608
# How often a library root that is not there yet (an unmounted drive) is
# looked for again, in seconds (default 30, minimum 5).
#LOCALFS_ROOT_RECHECK_SEC=30
# A certificate other than <TAILSCALE_CERT_HOST>.crt/.key in the repo
# folder. Set both; unset → the Tailscale cert, or plain HTTP without one.
#GATEWAY_CERTFILE=/path/to/cert.pem
#GATEWAY_KEYFILE=/path/to/key.pem
# Verbose logging (1/true/yes). Restart to apply.
#GATEWAY_DEBUG=1

# ── Listen addresses ─────────────────────────────────────────────────
#
#   ⚠  READ THIS ONE. The control API is UNAUTHENTICATED by design — browse,
#      play, playlists, rebuild-index, all of it. Access control is the
#      NETWORK, not a login. The values shipped below are 0.0.0.0, meaning
#      EVERY interface this machine has, which is the wrong default for
#      anything but a single-homed box on a trusted LAN.
#
#      Before you run this anywhere else, replace 0.0.0.0 with the addresses
#      you actually meant — and never port-forward any of them. On a machine
#      with a LAN address, a VPN and a tailnet, 0.0.0.0 is three exposures
#      where you wanted one. See SECURITY.md.
#
# Comma-separated host:port. Always include 127.0.0.1: the live test suite
# and the tools reach the gateway there.
#
#   Real example from the maintainer's box (tailnet + LAN + loopback):
#     GATEWAY_BIND_TLS=100.x.y.z:8443,192.168.1.125:8443,127.0.0.1:8443
#     GATEWAY_BIND_PLAIN=192.168.1.125:8765,100.x.y.z:8765,127.0.0.1:8765
#     LOCALFS_BIND=192.168.1.125
#   TLS listener needs a cert; without one it is dropped automatically and the
#   PLAIN addresses are served instead — hypercorn only reads `insecure_bind`
#   when TLS is on, so a certless run that left them there would listen on
#   NOTHING while logging a clean startup. Naming no usable address at all
#   (a stray comma, an empty list) now FAILS THE BOOT rather than starting a
#   server that answers nothing.
#   NOTE: a `tailscale cert` is issued for the TAILNET HOSTNAME, so adding a
#   LAN IP here serves a cert that does not match it — browsers warn, and a
#   cert-warning origin is not a trusted secure context (an installed PWA can
#   fail to register its Service Worker there). For LAN use, plain HTTP on a
#   private address is a secure context and works better.
GATEWAY_BIND_TLS=0.0.0.0:8443
GATEWAY_BIND_PLAIN=0.0.0.0:8765
# Extra host NAMES browsers may use to reach the gateway, comma-separated
# (e.g. a DNS alias). IP addresses, localhost, this Mac's name and
# TAILSCALE_CERT_HOST (+ its MagicDNS short name) are always allowed. Any
# other name gets a 403: that is the DNS-rebinding defence. A refused name is
# logged as "guard ✗ refused … add it to GATEWAY_ALLOWED_HOSTS".
GATEWAY_ALLOWED_HOSTS=
# The file server UPnP renderers fetch audio from. ONE address only
# (single socket) — use the LAN address renderers reach this machine at.
LOCALFS_BIND=0.0.0.0

# ── Alerts to your phone (optional) ─────────────────────────────────────────
# Push notifications when something goes wrong: the gateway restarted itself
# or is stuck in a restart loop, a library volume missing for an hour, a
# refused browser request, a certificate close to expiry, or a failed weekly
# backup / cert renewal / upgrade check. Two channels; set either or both.
# Nothing set = alerts off. Test: python3 dlna_alerts.py --test
# See dlna_alerts.py.
#
# 1. A text message from this Mac's Messages app (stays local; macOS asks
#    once to let the gateway control Messages). Number in international form
#    with a +, e.g. +316xxxxxxxx — NOT 0316…: Messages reads a leading 0 as a
#    domestic number, and 0316 is a Dutch landline area code.
ALERT_SMS_TO=
# SMS (needs the iPhone's Text Message Forwarding) or iMessage — tried first,
# the other is the fallback.
#ALERT_SMS_SERVICE=SMS
#
# 2. A push notification (ntfy protocol): install the ntfy app, subscribe to
#    a topic, put its URL here. On ntfy.sh anyone who knows the topic name can
#    read it, so make it long and random.
ALERT_PUSH_URL=
# Bearer token, for a protected topic or a private ntfy server.
ALERT_PUSH_TOKEN=
# One push per kind of problem per this many seconds.
#ALERT_MIN_INTERVAL_SEC=3600
# How long a library root may be missing before it is worth a push.
#ALERT_ROOT_WAIT_SEC=3600

# ── Content-Security-Policy (optional) ──────────────────────────────────────
# enforce (default): the PWA may run only its own script (see
#   dlna_asgi_headers.py); anything blocked is logged as "csp ✗ violation".
# report-only: the browser blocks nothing and only reports — the switch back
#   if enforcing ever breaks something in the PWA.
# off: no CSP (the other security headers are always sent).
#CSP_MODE=enforce

# ── Runtime watch (optional) ────────────────────────────────────────────────
# Seconds between checks that the Python this process runs from is still on
# disk. A `brew upgrade` that deletes the running interpreter's keg leaves the
# gateway half-alive (radio plays, music does not); the watch then exits the
# worker non-zero so launchd restarts it on the new Python. 0 disables.
# See dlna_runtime_watch.py.
#RUNTIME_WATCH_SEC=60

# ── Not read by the gateway ────────────────────────────────────
# Keys an install may keep here for the beets enrichment toolchain
# (tools/beets_enrich.py). Nothing in this repo reads them: beets takes its
# keys from ~/.config/beets/config.yaml (acoustid: apikey, discogs:
# user_token). Listed so a .env holding them is recognised as deliberate;
# tests/test_env_example.py fails on any OTHER key nothing reads.
#ACOUSTID_API_KEY=
#DISCOGS_TOKEN=
