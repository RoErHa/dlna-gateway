# macOS / editor
.DS_Store
.vscode/
.idea/
.claude/

# env / secrets
.env
.env.*
# .env.example IS tracked (the template). Inline comments aren't
# supported by .gitignore, so the negation must be on its own line:
!.env.example

# Personal prep recipe — operational, not public docs.
PREPARE_PUBLIC_RELEASE.md

# Python
__pycache__/
*.pyc
.venv/
.venv
venv/
video_posters/

# Node / JS
node_modules/
dist/
build/

# Docker / misc
docker-compose.override.yml
*.log
gateway.log*
logs/
.snapshots/
*.zip
*.tar
*.tar.gz
*.tgz
*.odt
*.rtf
# Stray PDF exports (e.g. printed CLAUDE.md/README.md). Real docs
# under docs/ are still tracked via the negation below.
*.pdf
!docs/*.pdf
project docs/

# DB / runtime
*.sqlite3
library.db*
data/
db/
config.json

# TLS / Tailscale cert material — NEVER commit private keys
*.crt
*.crt.bak
*.key
*.key.bak
*.pem

# Personal SQL dumps (use schema.sql in the repo for structure)
dump.sql
library_dump.sql

# Per-library scan output from tools/find_corrupt_audio.py — user-specific,
# not project content.
corrupt-audio.txt

# server-side cover-art byte cache (dlna_art_cache)
art_cache/

# SECURITY_AUDIT.html stays UNTRACKED, deliberately: it names exact working
# exploit shapes for this gateway, and the repo is public. The findings
# themselves are not hidden — SECURITY.md summarises all eleven, and
# CLAUDE.md -> "Security posture" carries the reasoning and the invariants.
# Publishing the probe shapes adds nothing for a reader and hands a
# ready-made checklist to anyone scanning someone else's instance.
# (docs/FIELD_MANUAL.html was un-ignored on 2026-08-21 — it is architecture
# documentation with nothing sensitive in it, and it is worth reading.)
docs/SECURITY_AUDIT.html
