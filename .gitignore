# macOS / editor
.DS_Store
.vscode/
.idea/
.claude/

# env / secrets
.env
.env.*
# .env.example IS tracked (the template). Inline comments aren't
# supported by .gitignore, so the negation must be on its own line:
!.env.example

# Personal prep recipe — operational, not public docs.
PREPARE_PUBLIC_RELEASE.md

# Python
__pycache__/
*.pyc
.venv/
.venv
venv/
video_posters/

# Node / JS
node_modules/
dist/
build/

# Docker / misc
docker-compose.override.yml
*.log
gateway.log*
logs/
.snapshots/
*.zip
*.tar
*.tar.gz
*.tgz
*.odt
*.rtf
# Stray PDF exports (e.g. printed CLAUDE.md/README.md). Real docs
# under docs/ are still tracked via the negation below.
*.pdf
!docs/*.pdf
project docs/

# DB / runtime
*.sqlite3
library.db*
data/
db/
config.json

# TLS / Tailscale cert material — NEVER commit private keys
*.crt
*.crt.bak
*.key
*.key.bak
*.pem

# Personal SQL dumps (use schema.sql in the repo for structure)
dump.sql
library_dump.sql

# Per-library scan output from tools/find_corrupt_audio.py — user-specific,
# not project content.
corrupt-audio.txt

# server-side cover-art byte cache (dlna_art_cache)
art_cache/

# Published-artifact copies kept locally for offline reading (docs/REPORTS.html
# is the tracked exception — these two are generated deliverables, not source).
# SECURITY_AUDIT.html deliberately stays UNTRACKED: it names exact exploit
# shapes for this gateway, and the repo has a public remote.
docs/SECURITY_AUDIT.html
docs/FIELD_MANUAL.html
