<!--
  com.roha.dlna-gateway.plist  —  TEMPLATE (macOS LaunchAgent)
  ────────────────────────────────────────────────────────────
  Starts the DLNA Gateway automatically when the user session
  begins. **This is a template — edit the placeholders below before
  installing.**

  BEFORE YOU INSTALL:
    1. Replace every `/path/to/dlna-gateway` with the absolute path
       to your clone (e.g. /Users/<you>/dlna-gateway).
    2. Optionally rename the file + the <Label> string to your own
       namespace (e.g. `com.<you>.dlna-gateway.plist` /
       `<Label>com.<you>.dlna-gateway</Label>`) — both must match.
    3. Set SUBSONIC_PASSWORD (and optionally SUBSONIC_USER) — or
       leave SUBSONIC_PASSWORD empty to refuse Subsonic calls. The
       same vars can come from `.env` instead (see .env.example).

  INSTALL:
    cp com.roha.dlna-gateway.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.roha.dlna-gateway.plist

  MANAGE:
    launchctl list | grep dlna          # check it's loaded + PID
    launchctl kickstart -k gui/$(id -u)/com.roha.dlna-gateway

  LOGS:
    tail -f /path/to/dlna-gateway/gateway.log   # rotating daily log
    cat /tmp/dlna-gateway.out
    cat /tmp/dlna-gateway.err
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roha.dlna-gateway</string>

    <key>WorkingDirectory</key>
    <string>/path/to/dlna-gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/dlna-gateway/.venv/bin/python</string>
        <string>/path/to/dlna-gateway/dlna_gateway.py</string>
        <string>--no-browser</string>
    </array>

    <!-- Start at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically if it crashes -->
    <key>KeepAlive</key>
    <false/>

    <!-- Wait 10s before restart to avoid tight crash loops -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- File descriptor and process limits — MUST be inside SoftResourceLimits.
         Without this wrapper, launchd silently ignores them and the gateway
         hits the default 256 FD limit, causing "Too many open files" and
         "unable to open database" errors under Chromecast mDNS discovery. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
        <key>NumberOfProcesses</key>
        <integer>512</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/dlna-gateway.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dlna-gateway.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

        <!-- Subsonic API credentials. Prefer setting these in .env
             (gitignored) instead of this plist — the gateway loads
             .env at startup via python-dotenv. Values set here
             override .env. Leaving SUBSONIC_PASSWORD empty makes the
             /rest/* API return 503 on every call (safe default). -->
        <key>SUBSONIC_USER</key>
        <string>user</string>
        <key>SUBSONIC_PASSWORD</key>
        <string></string>
    </dict>
</dict>
</plist>
