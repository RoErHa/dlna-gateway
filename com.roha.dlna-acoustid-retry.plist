<!--
  com.roha.dlna-acoustid-retry.plist  —  TEMPLATE (macOS LaunchAgent)
  ───────────────────────────────────────────────────────────────
  Weekly AcoustID notfound retry for the DLNA gateway. Drops every
  `source='notfound'` row from metadata_overrides and kickstarts the
  gateway so its 120s-post-startup ACOUSTID_FETCHER.start_initial_scan()
  re-fingerprints all the now-bare tracks. New MusicBrainz entries
  added since the last miss get a fresh chance to match.

  Runs every Monday at 05:30 local (one hour after the cert renewer,
  so the two jobs never interleave a gateway restart).

  BEFORE YOU INSTALL:
    1. Replace `/path/to/dlna-gateway` with your clone's absolute
       path.
    2. ACOUSTID_API_KEY must be set in .env (the script reads it
       at run time and no-ops if absent).
    3. Optionally rename the file + the <Label> to your namespace.

  INSTALL:
    cp com.roha.dlna-acoustid-retry.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.roha.dlna-acoustid-retry.plist

  MANAGE:
    launchctl list | grep acoustid-retry                            # confirm
    launchctl kickstart gui/$(id -u)/com.roha.dlna-acoustid-retry   # run now
    tail -f /path/to/dlna-gateway/acoustid-retry.log                # results
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roha.dlna-acoustid-retry</string>

    <key>WorkingDirectory</key>
    <string>/path/to/dlna-gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/dlna-gateway/retry-acoustid-weekly.sh</string>
    </array>

    <!-- Weekly: Monday 05:30 (Weekday 1 = Mon on macOS launchd) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- If the Mac was asleep at the scheduled time, run as soon as it wakes -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/dlna-acoustid-retry.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dlna-acoustid-retry.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
